DEEPSEEK_API_KEY=sk-...
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# Web sohbeti (https://<adresiniz>/sohbet): giriş şifresi = kys şifresi (KILIT_* özetleri; `python kurulum.py` üretir,
# en az 12 karakterlik şifre). WEB_TOTP_SIR: doğrulama uygulaması (Google/Microsoft Authenticator) anahtarı, base32;
# boş bırakırsanız girişte yalnızca şifre istenir (önerilmez). WEB_PAROLA yalnızca kys şifresi hiç ayarlanmamışsa yedektir.
WEB_TOTP_SIR=
# WEB_PAROLA=
# Türetilen bağlantı ve anahtarların tohumu: uzun rastgele bir değer (ör. python -c "import secrets;print(secrets.token_hex(32))").
OPENDELEGATE_SIR=

# İsteğe bağlı: Telegram kanalı. İkisi de boşsa Telegram tamamen kapalıdır.
# TELEGRAM_BOT_TOKEN=123456:ABC...
# TELEGRAM_CHAT_ID=123456789

# PC ajanı (ajan/.env içindeki AJAN_SECRET ile aynı olmalı). Boşsa görev API'si kapalı.
AJAN_SECRET=

# Web arama (webde_ara): https://app.tavily.com -> API Keys (kartsız ücretsiz plan). Boşsa arama kapalı.
TAVILY_API_KEY=

# Sesli mesaj -> metin: https://console.groq.com -> API Keys (gsk_..., kartsız). Boşsa sesli mesaj kapalı.
GROQ_API_KEY=
# STT_DIL=tr          # boş = otomatik dil algılama
# STT_MODEL=whisper-large-v3-turbo

# Kalıcı hafıza: Neon Postgres adresi (neon.tech -> Connect, pooled). Boşsa SQLite (VEKIL_DB).
DATABASE_URL=

# OneDrive (rclone). Render'da: /etc/secrets/rclone.conf (Secret File).
# Lokalde boş bırak -> rclone'un varsayılanı (%APPDATA%\rclone\rclone.conf) kullanılır.
# RCLONE_CONFIG=/etc/secrets/rclone.conf

# Opsiyonel
# ONEDRIVE_REMOTE=onedrive
# RCLONE_BIN=rclone
# PC_INDIRME_KLASORU=%USERPROFILE%\Downloads
# WEBHOOK_URL=https://servis-adin.onrender.com   # boşsa polling (lokal)
# WEBHOOK_SECRET=uzun-rastgele-bir-deger
# ONEDRIVE_KLASORLER=Masaüstü,Belgeler
# AJAN_CEVRIMICI_SN=15
# GOREV_SONUC_ZAMAN_ASIMI=150
# ONAY_ZAMAN_ASIMI=300
# MAKS_ADIM=10
# GECMIS_LIMITI=30
# VEKIL_DB=C:\vekil\vekil.db
# Salt okunur takvim: Google Takvim -> Ayarlar -> Takvimi entegre et -> iCal biçiminde gizli adres (https). Adres bir sırdır.
# TAKVIM_ICS_URL=
