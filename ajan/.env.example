# C:\vekil-ajan\.env  — bu dosyayı kopyalayıp doldur, repoya koyma.
VEKIL_URL=https://<servis-adın>.onrender.com
AJAN_SECRET=<Render'daki AJAN_SECRET ile birebir aynı>

# Opsiyonel
# YOKLAMA_ARALIGI=5
# TERMINAL_ZAMAN_ASIMI=60

# Periyodik senkron (PC -> OneDrive, rclone sync; açılışta + her 30 dk). Kapatmak için: SENKRON_KAYNAK=
# SENKRON_KAYNAK=C:\Users\kullanici\OneDrive\Masaüstü\proje
# SENKRON_HEDEF=onedrive:Masaüstü/proje
# SENKRON_EXCLUDE=node_modules/**            # virgülle birden fazla: a/**,b/*.tmp
# SENKRON_ARALIK_DK=30
# SENKRON_MAKS_SILME=25                       # tek seferde en fazla bu kadar silme; aşarsa durur ve hata sayılır
# RCLONE_BIN=rclone

# Dosya izleme tarama aralığı (sn). Kurallar Vekil'den gelir (/izle).
# IZLEME_ARALIK_SN=60
