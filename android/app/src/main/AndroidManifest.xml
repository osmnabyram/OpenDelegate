<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />
    <!-- Uyanınca ekranı yakıp paneli kilit ekranının üstünde göstermek için. -->
    <uses-permission android:name="android.permission.TURN_SCREEN_ON" />
    <!-- "Annemi ara": rehberde kişiyi bulup arar. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <!-- Uyanınca bip yerine kısa titreşim (bip kayda girip ilk kelimeyi bozuyordu). -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Android 11+: OpenDelegate'in açabileceği uygulamaları ve saat uygulamasını görebilmek için. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SET_ALARM" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SET_TIMER" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:networkSecurityConfig="@xml/ag_guvenligi"
        android:usesCleartextTraffic="false"
        android:icon="@mipmap/ic_launcher"
        android:label="OpenDelegate"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Kapatma tuşu uzun basış / kaydırmalı gezinmede alt çubuk uzun basış: Android bunu
                 "dijital asistan" olarak ayarlı uygulamaya gönderir (Ayarlar > Uygulamalar > Varsayılan
                 uygulamalar > Dijital asistan uygulaması -> OpenDelegate). -->
            <intent-filter>
                <action android:name="android.intent.action.ASSIST" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Ekran kapalı/kilitliyken paneli kilit ekranının üstünde gösterir. -->
        <activity
            android:name=".KilitEkrani"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:taskAffinity="com.opendelegate.app.kilit"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/KilitTema" />

        <!-- OpenDelegate telefonu ekrandan kullanır (Ayarlar > Erişilebilirlik'ten bir kez açılır). -->
        <service
            android:name=".VekilErisim"
            android:exported="true"
            android:label="@string/erisim_adi"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/erisim" />
        </service>

        <!-- Bildirimleri okur (Ayarlar > Bildirim erişimi). -->
        <service
            android:name=".BildirimDinleyici"
            android:exported="true"
            android:label="OpenDelegate"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <service
            android:name=".VekilService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <receiver
            android:name=".BootReceiver"
            android:exported="true"
            android:enabled="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Sadece adb denemesi (am broadcast): DUMP izni yalnız kabukta/sistemde var, uygulamalar tetikleyemez. -->
        <receiver
            android:name=".DenemeAlici"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.opendelegate.app.DENEME" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
