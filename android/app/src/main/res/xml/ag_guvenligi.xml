<?xml version="1.0" encoding="utf-8"?>
<!-- Açık metin (http) trafiği kapalı; sadece sistem sertifikaları güvenilir (kullanıcının eklediği CA ile araya girilemez). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
